   if (reg) {\n        dl |= 1\n        du |= 1\n    }\n}\nlet i2cAdr = 0\ni2cAdr = 39\nbasic.forever(function () {\n    setBacklight(true)\n    basic.pause(1000)\n    setBacklight(false)\n    basic.pause(1000)\n})\n","README.md":"","main.py":"def writeLCD(reg: bool, data: int):\n    dl = data & 0x0f << 4;\n    du = data & 0xf0;\n    if reg:\n        dl |= 1;\n        du |= 1;\n    \n\ndef setBacklight(on: bool):\n    if on:\n        pins.i2c_write_number(i2cAdr, 12, NumberFormat.INT8_LE, False)\n    else:\n        pins.i2c_write_number(i2cAdr, 4, NumberFormat.INT8_LE, False)\ni2cAdr = 0\ni2cAdr = 39\n\ndef on_forever():\n    setBacklight(True)\n    basic.pause(1000)\n    setBacklight(False)\n    basic.pause(1000)\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"Untitled\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1748356070510,"editorVersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"5_HE9/cp6).:lJjt*+/Z\">i2cAdr</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"5_HE9/cp6).:lJjt*+/Z\">i2cAdr</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">39</field></shadow></value></block></statement></block><block type=\"device_forever\" x=\"301\" y=\"20\"><statement name=\"HANDLER\"><block type=\"function_call\"><mutation name=\"setBacklight\" functionid=\"hm+FH.8WFJKVsZ9t-F2s\"><arg name=\"on\" id=\"fk42ukkq0ugtlf4pqu7z8\" type=\"boolean\"></arg></mutation><value name=\"fk42ukkq0ugtlf4pqu7z8\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow></value><next><block type