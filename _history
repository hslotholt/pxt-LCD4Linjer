  writeLCD(true, 0x17);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x48); // Set CGRAM register for char 1 'Ø'\n    writeLCD(true, 0x05);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x13);\n    writeLCD(true, 0x15);\n    writeLCD(true, 0x19);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x14);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x50); // Set CGRAM register for char 2 'Å'\n    writeLCD(true, 0x04);\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x04);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x1f);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x58); // Set CGRAM register for char 3 'æ'\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x03);\n    writeLCD(true, 0x06);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x1f);\n    writeLCD(true, 0x12);\n    writeLCD(true, 0x13);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x60); // Set CGRAM register for char 4 'ø'\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x05);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x15);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x14);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x68); // Set CGRAM register for char 5 'å'\n    writeLCD(true, 0x04);\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x0e);\n    writeLCD(true, 0x01);\n    writeLCD(true, 0x0f);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x0f);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x80);\n}\n\nfunction writeString (str: string) {\n    let written = 0;\n    while (written < str.length) \n    {\n        if(charPos > 19)\n        {\n            charPos = 0;\n            lineNr += 1;\n            if (lineNr > 3) lineNr = 0;\n            setCursorLocation(lineNr, charPos);\n        }\n        let stop = written + Math.min(20 - charPos, str.length - written);\n\n        for (; written < stop; written++) \n        {\n            let c = str.charCodeAt(written);\n            switch(c) {\n                case 198:\n                    c = 0; // Æ\n                break;\n                case 216:\n                    c = 1; // Ø\n                break;\n                case 197:\n                    c = 2; // Å\n                break;\n                case 230:\n                    c = 3; // æ\n                break;\n                case 248:\n                    c = 4; // ø\n                break;\n                case 229:\n                    c = 5; // å\n                break;\n            }\n            writeLCD(true, c);\n        }\n        charPos += written;\n    }\n}\n\nbasic.forever(function () {\n})\n","README.md":"","main.py":"def writeLCD(reg: bool, data: int):\n    dl = data & 0x0f << 4;\n    du = data & 0xf0;\n    if reg:\n        dl |= 1;\n        du |= 1;\n    \n\ndef setBacklight(on: bool):\n    if on:\n        pins.i2c_write_number(i2cAdr, 12, NumberFormat.INT8_LE, False)\n    else:\n        pins.i2c_write_number(i2cAdr, 4, NumberFormat.INT8_LE, False)\ni2cAdr = 0\ni2cAdr = 39\n\ndef on_forever():\n    setBacklight(True)\n    basic.pause(1000)\n    setBacklight(False)\n    basic.pause(1000)\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"Untitled\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1748380713566,"editorVersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"5_HE9/cp6).:lJjt*+/Z\">i2cAdr</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"5_HE9/cp6).:lJjt*+/Z\">i2cAdr</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">39</field></shadow></value></