controls_if\"><mutation else=\"1\"></mutation><value name=\"IF0\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"argument_reporter_boolean\"><field name=\"VALUE\">on</field></block></value><statement name=\"DO0\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"ctrlBits |= 0x08;\" numlines=\"1\"></mutation></block></statement><statement name=\"ELSE\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"ctrlBits &amp;= 0xf7;\" numlines=\"1\"></mutation></block></statement><next><block type=\"i2c_writenumber\"><field name=\"format\">NumberFormat.Int8LE</field><value name=\"address\"><block type=\"variables_get\"><field name=\"VAR\" id=\"eGWq;H]8z7@S|IdZ5@lB\">i2cAdr</field></block></value><value name=\"value\"><block type=\"variables_get\"><field name=\"VAR\" id=\".6/P432AzrLM1sr45=Qz\">ctrlBits</field></block></value><value name=\"repeat\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">FALSE</field></shadow></value></block></next></block></statement></block></xml>","main.ts":"let i2cAdr = 0x27;\nlet ctrlBits = 0xf8; // Initialize upper bits to one, this ensures we wait for setup of R/W and RS during first use\nlet charPos = 0;\nlet lineNr = 0;\nlet lcdInitialized = false;\n\nwriteString(\"Magne 9 år\");\n\nfunction initLCD() {\n    lcdInitialized = true;\n    writeLCD(false, 0x33);\n    pause(2);\n    pins.i2cWriteNumber(i2cAdr, 0x38, NumberFormat.Int8LE, false);\n    pins.i2cWriteNumber(i2cAdr, 0x3c, NumberFormat.Int8LE, false);\n    pins.i2cWriteNumber(i2cAdr, 0x38, NumberFormat.Int8LE, false);\n    pause(2);\n    pins.i2cWriteNumber(i2cAdr, 0x28, NumberFormat.Int8LE, false);\n    pins.i2cWriteNumber(i2cAdr, 0x2c, NumberFormat.Int8LE, false);\n    pins.i2cWriteNumber(i2cAdr, 0x28, NumberFormat.Int8LE, false);\n    pause(2);\n    writeLCD(false, 0x28);\n    displayControl(true, false, false);\n    writeLCD(false, 0x06); // cursor moves to right\n    generateDKChars();\n    clearLCD();\n}\n\nfunction writeLCD(dRegister: boolean, data: number) {\n    if (!lcdInitialized) initLCD();\n\n    let du = data & 0xf0;\n    let dl = data << 4;\n    let ctrl = ctrlBits & 0x08;\n    if (dRegister) ctrl |= 0x01;\n\n    if (ctrl != ctrlBits) {\n        // If R/W or RS has changed we set that change before setting EN high\n        pins.i2cWriteNumber(i2cAdr, ctrl | du, NumberFormat.Int8LE, false);\n    }\n    pins.i2cWriteNumber(i2cAdr, 0x04 | ctrl | du, NumberFormat.Int8LE, false); // Set EN high\n    pins.i2cWriteNumber(i2cAdr, ctrl | du, NumberFormat.Int8LE, false); // Latch upper 4 bits\n    pins.i2cWriteNumber(i2cAdr, 0x04 | ctrl | dl, NumberFormat.Int8LE, false); // Set EN high\n    pins.i2cWriteNumber(i2cAdr, ctrl | dl, NumberFormat.Int8LE, false); // Latch lower 4 bits\n    ctrlBits = ctrl;\n}\n\nfunction clearLCD() {\n    writeLCD(false, 0x01);\n    pause(2);\n}\n\nfunction setBacklight(on: boolean) {\n    if (on) ctrlBits |= 0x08;\n    else ctrlBits &= 0xf7;\n    pins.i2cWriteNumber(i2cAdr, ctrlBits, NumberFormat.Int8LE, false);\n}\n\nfunction displayControl(displayOn: boolean, cursorOn: boolean, cursorBlinking: boolean) {\n    let d = 0x08;\n    if (displayOn) d |= 0x04;\n    if (cursorOn) d |= 0x02;\n    if (cursorBlinking) d |= 0x01;\n    writeLCD(false, d);\n}\n\nfunction setCursorLocation(line: number, char: number) {\n    let d = 0x80 + char;\n    if (line == 1) d += 0x40;\n    if (line == 2) d += 0x14;\n    if (line == 3) d += 0x54;\n    writeLCD(false, d);\n}\n\nfunction generateDKChars() {\n    writeLCD(false, 0x40); // Set CGRAM register for char 0 'Æ'\n    writeLCD(true, 0x07);\n    writeLCD(true, 0x0c);\n    writeLCD(true, 0x14);\n    writeLCD(true, 0x1f);\n    writeLCD(true, 0x14);\n    writeLCD(true, 0x14);\n    writeLCD(true, 0x17);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x48); // Set CGRAM register for char 1 'Ø'\n    writeLCD(true, 0x05);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x13);\n    writeLCD(true, 0x15);\n    writeLCD(true, 0x19);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x14);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x50); // Set CGRAM register for char 2 'Å'\n    writeLCD(true, 0x04);\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x04);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x1f);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x58); // Set CGRAM register for char 3 'æ'\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x03);\n    writeLCD(true, 0x06);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x1f);\n    writeLCD(true, 0x12);\n    writeLCD(true, 0x13);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x60); // Set CGRAM register for char 4 'ø'\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x05);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x15);\n    writeLCD(true, 0x0a);\n    writeLCD(true, 0x14);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x68); // Set CGRAM register for char 5 'å'\n    writeLCD(true, 0x04);\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x0e);\n    writeLCD(true, 0x01);\n    writeLCD(true, 0x0f);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x0f);\n    writeLCD(true, 0x00);\n\n    writeLCD(false, 0x70); // Set CGRAM register for char 6 modified 'g'\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x0f);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x0f);\n    writeLCD(true, 0x01);\n    writeLCD(true, 0x0e);\n\n    writeLCD(false, 0x78); // Set CGRAM register for char 7 modified 'y'\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x00);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x11);\n    writeLCD(true, 0x0f);\n    writeLCD(true, 0x01);\n    writeLCD(true, 0x0e);\n\n    writeLCD(false, 0x80);\n}\n\nfunction writeString(str: string) {\n    let written = 0;\n    while (written < str.length) {\n        if (charPos > 19) {\n            charPos = 0;\n            lineNr += 1;\n            if (lineNr > 3) lineNr = 0;\n            setCursorLocation(lineNr, charPos);\n        }\n        let stop = written + Math.min(20 - charPos, str.length - written);\n\n        for (; written < stop; written++) {\n            let c = str.charCodeAt(written);\n            switch (c) {\n                case 103:\n                    c = 6; // Modified g\n                    break;\n                case 121:\n                    c = 7; // Modified y\n                    break;\n                case 198:\n                    c = 0; // Æ\n                    break;\n                case 216:\n                    c = 1; // Ø\n                    break;\n                case 197:\n                    c = 2; // Å\n                    break;\n                case 230:\n                    c = 3; // æ\n                    break;\n                case 248:\n                    c = 4; // ø\n                    break;\n                case 229:\n                    c = 5; // å\n                    break;\n            }\n            writeLCD(true, c);\n        }\n        charPos += written;\n    }\n}\n\nbasic.forever(function () {\n})\n","README.md":"","main.py":"def writeLCD(reg: bool, data: int):\n    dl = data & 0x0f << 4;\n    du = data & 0xf0;\n    if reg:\n        dl |= 1;\n        du |= 1;\n    \n\ndef setBacklight(on: bool):\n    if on:\n        pins.i2c_write_number(i2cAdr, 12, NumberFormat.INT8_LE, False)\n    else:\n        pins.i2c_write_number(i2cAdr, 4, NumberFormat.INT8_LE, False)\ni2cAdr = 0\ni2cAdr = 39\n\ndef on_forever():\n    setBacklight(True)\n    basic.pause(1000)\n    setBacklight(False)\n    basic.pause(1000)\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"Untitled\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1748383237403}